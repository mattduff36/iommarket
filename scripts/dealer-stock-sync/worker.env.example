# Dealer stock worker configuration reference.
# Copy one target into a gitignored file. Do not put real secrets in this example.
#   private/dealer-stock-worker/preview.env
#   private/dealer-stock-worker/production.env
# The launcher reads only that file. It never loads .env.local.
# It does not set DEALER_STOCK_SYNC_PRODUCTION_ENABLED for you.
# Leave weekly dealer sync disabled. This PC launcher runs with --manual.

# --- preview: https://itrader.dev, project syneonzucehwlghqmfbg ---
DEALER_STOCK_SYNC_TARGET=preview
VERCEL_ENV=preview
ITRADER_DEPLOYMENT_ROLE=staging
NODE_ENV=production
DEALER_STOCK_SYNC_WORKER=1
NEXT_PUBLIC_APP_URL=https://itrader.dev
NEXT_PUBLIC_SUPABASE_URL=https://syneonzucehwlghqmfbg.supabase.co
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_DB_CA_CERT=
MEDIA_PROVIDER=imagekit
NEXT_PUBLIC_MEDIA_PROVIDER=imagekit
MEDIA_UPLOAD_PROVIDER=imagekit
IMAGEKIT_UPLOADS_ENABLED=1
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/itraderim
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# --- production: https://itrader.im, project snlqivvogfqesxpbjiei ---
# Put these in private/dealer-stock-worker/production.env only.
# Uncomment DEALER_STOCK_SYNC_PRODUCTION_ENABLED only after production is accepted.
# DEALER_STOCK_SYNC_TARGET=production
# VERCEL_ENV=production
# NODE_ENV=production
# DEALER_STOCK_SYNC_WORKER=1
# DEALER_STOCK_SYNC_PRODUCTION_ENABLED=1
# NEXT_PUBLIC_APP_URL=https://itrader.im
# NEXT_PUBLIC_SUPABASE_URL=https://snlqivvogfqesxpbjiei.supabase.co
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# SUPABASE_DB_CA_CERT=
# MEDIA_PROVIDER=imagekit
# NEXT_PUBLIC_MEDIA_PROVIDER=imagekit
# MEDIA_UPLOAD_PROVIDER=imagekit
# IMAGEKIT_UPLOADS_ENABLED=1
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/itraderim
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
