#!/bin/sh
# Blocks secrets from being committed. Usage collection is local and must not
# stage a rolling ledger file.

STAGED_ENV=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.|$)' | grep -v '\.env\.example$')

if [ -n "$STAGED_ENV" ]; then
  echo ""
  echo "  COMMIT BLOCKED - secrets file(s) staged:"
  echo ""
  echo "$STAGED_ENV" | sed 's/^/    /'
  echo ""
  echo "  Remove them from the commit with:"
  echo "    git restore --staged <file>"
  echo ""
  exit 1
fi

# Collection is best-effort. It must not stage a usage ledger or block the commit.
if [ -z "$SKIP_CURSOR_USAGE" ]; then
  node --no-warnings --env-file-if-exists=.env.local --experimental-sqlite \
    scripts/cursor-usage/collect.mjs --bounded \
    || echo "Cursor usage collection unavailable. Commit will continue."
fi

exit 0
