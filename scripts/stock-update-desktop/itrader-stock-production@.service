[Unit]
Description=iTrader Production Stock Update (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=itrader-stock-prod-%i
Group=itrader-stock
StateDirectory=itrader-stock-production-%i
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/itrader-stock/runtime/bin/node /opt/itrader-stock/controller.mjs serve %i production
Restart=on-failure
RestartSec=30
TimeoutStopSec=12min
KillMode=mixed
Nice=10
CPUQuota=65%
MemoryMax=2G
TasksMax=256
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
