[Unit]
Description=Reload the iTrader Preview controller after pairing (%i)
ConditionPathExists=/var/lib/itrader-stock-preview-%i/session.json

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl enable itrader-stock-preview@%i.service
ExecStart=-/usr/bin/systemctl reset-failed itrader-stock-preview@%i.service
ExecStart=/usr/bin/systemctl --no-block restart itrader-stock-preview@%i.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
