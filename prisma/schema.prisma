generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth & Users
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  DEALER
  ADMIN
}

enum DealerTier {
  STARTER
  PRO
}

enum DealerReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum DealerReviewerType {
  REGISTERED
  ANONYMOUS
}

enum DealerReviewResponseRevisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum DealerReviewDisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  authUserId     String    @unique
  email          String    @unique
  name           String?
  phone          String?
  bio            String?
  avatarUrl      String?
  role           UserRole  @default(USER)
  regionId       String?
  disabledAt     DateTime?
  disabledReason String?
  disabledReasonCode UserDisableReason?
  deletedAt      DateTime?
  deletionReason String?
  deletionRequestedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  region              Region?              @relation(fields: [regionId], references: [id])
  listings            Listing[]
  dealerProfile       DealerProfile?
  reports             Report[]
  favourites          Favourite[]
  savedSearches       SavedSearch[]
  listingViews        ListingView[]
  dealerReviews       DealerReview[]
  listingStatusEvents ListingStatusEvent[]
  listingRevisionsDecided ListingRevision[] @relation("ListingRevisionDecidedBy")
  dealerReviewModerationEvents DealerReviewModerationEvent[]
  dealerResponseRevisionsDecided DealerReviewResponseRevision[]        @relation("DealerResponseRevisionDecidedBy")
  dealerResponseModerationEvents DealerReviewResponseModerationEvent[]
  dealerReviewDisputesOpened     DealerReviewDispute[]                 @relation("DealerReviewDisputeOpenedBy")
  dealerReviewDisputesDecided    DealerReviewDispute[]                 @relation("DealerReviewDisputeDecidedBy")
  dealerReviewDisputeEvents      DealerReviewDisputeEvent[]
  monitoringIssueStatusEvents MonitoringIssueStatusEvent[]
  freeListingClaim   FreeListingClaim?
  listingImageUploadIntents ListingImageUploadIntent[]
  policyAcceptances PolicyAcceptance[]
  cancellationRequestsRequested DealerCancellationRequest[] @relation("CancellationRequestedBy")
  cancellationRequestsProcessed DealerCancellationRequest[] @relation("CancellationProcessedBy")
  cancellationRequestEvents DealerCancellationRequestEvent[]
  accountDeletionJob AccountDeletionJob?

  @@index([authUserId])
  @@index([email])
}

model DealerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  slug      String   @unique
  bio       String?
  website   String?
  phone     String?
  logoUrl   String?
  verified  Boolean  @default(false)
  tier      DealerTier @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings      Listing[]
  subscriptions Subscription[]
  reviews       DealerReview[]
  cancellationRequests DealerCancellationRequest[]

  @@index([slug])
}

// ---------------------------------------------------------------------------
// Geography
// ---------------------------------------------------------------------------

model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  users    User[]
  listings Listing[]
  listingRevisions ListingRevision[]

  @@index([slug])
  @@index([active, sortOrder])
}

// ---------------------------------------------------------------------------
// Categories & Attributes (EAV)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  attributeDefinitions AttributeDefinition[]
  listings             Listing[]
  listingRevisions     ListingRevision[]

  @@index([slug])
  @@index([parentId])
}

model AttributeDefinition {
  id         String  @id @default(cuid())
  categoryId String
  name       String
  slug       String
  dataType   String  // text, number, select, boolean
  required   Boolean @default(false)
  options    String? // JSON-encoded options for select type
  sortOrder  Int     @default(0)

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ListingAttributeValue[]
  revisionValues ListingRevisionAttributeValue[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Vehicle catalogue (lookup-only; listing make/model values remain EAV text)
// ---------------------------------------------------------------------------

model VehicleMake {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  source         String
  sourceVersion  String
  importedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  models  VehicleModel[]
  aliases VehicleModelAlias[]

  @@index([active, sortOrder, name])
  @@index([source, sourceVersion])
}

model VehicleModel {
  id             String   @id @default(cuid())
  makeId         String
  name           String
  normalizedName String
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  source         String
  sourceVersion  String
  importedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  make    VehicleMake         @relation(fields: [makeId], references: [id], onDelete: Restrict)
  aliases VehicleModelAlias[]

  @@unique([id, makeId])
  @@unique([makeId, normalizedName])
  @@index([makeId, active, sortOrder, name])
  @@index([source, sourceVersion])
}

model VehicleModelAlias {
  id             String   @id @default(cuid())
  makeId         String
  modelId        String
  name           String
  normalizedName String
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  source         String
  sourceVersion  String
  importedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  make  VehicleMake  @relation(fields: [makeId], references: [id], onDelete: Restrict)
  model VehicleModel @relation(fields: [modelId, makeId], references: [id, makeId], onDelete: Restrict)

  @@unique([makeId, normalizedName])
  @@index([normalizedName, active])
  @@index([modelId, active, sortOrder])
  @@index([makeId, active, sortOrder])
  @@index([source, sourceVersion])
}

// ---------------------------------------------------------------------------
// Listings
// ---------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  LIVE
  EXPIRED
  TAKEN_DOWN
  SOLD
  REJECTED
}

enum ListingLifecycleAction {
  SUBMIT
  WITHDRAW
  APPROVE
  REJECT
  TAKE_DOWN
  EXPIRE
  MARK_SOLD
  RENEW
  REINSTATE_LIVE
  RETURN_TO_DRAFT
  ACCOUNT_DISABLE
  ACCOUNT_DISABLE_PENDING
  SYSTEM_BACKFILL
  SUBMIT_REVISION
  APPROVE_REVISION
  REJECT_REVISION
}

enum ListingModerationReason {
  FRAUD
  PROHIBITED
  MISLEADING
  DUPLICATE
  POLICY
  SAFETY
  ACCOUNT_DISABLED
  OTHER
}

enum ReportReasonCode {
  FRAUD
  PROHIBITED
  MISLEADING
  DUPLICATE
  POLICY
  SAFETY
  OTHER
}

enum UserDisableReason {
  POLICY
  FRAUD
  ABUSE
  CHARGEBACK
  OTHER
}

enum RefundReason {
  DUPLICATE
  REQUESTED_BY_CUSTOMER
  FRAUD
  SERVICE_NOT_PROVIDED
  OTHER
}

enum DealerReviewModerationReason {
  POLICY
  ABUSE
  SPAM
  OFF_TOPIC
  OTHER
}

enum ListingStatusEventSource {
  USER
  ADMIN
  SYSTEM
  PAYMENT
}

model Listing {
  id          String        @id @default(cuid())
  userId      String
  dealerId    String?
  categoryId  String
  regionId    String
  title       String
  description String
  price       Int           // stored in pence
  status      ListingStatus @default(DRAFT)
  featured    Boolean       @default(false)
  slug        String?
  viewCount   Int           @default(0)
  expiresAt   DateTime?
  soldAt      DateTime?
  trustDeclarationAccepted   Boolean  @default(false)
  trustDeclarationAcceptedAt DateTime?
  photoRevision              Int      @default(0)
  lastPhotoMutationId        String?  @unique
  lastPhotoMutationHash      String?
  lifecycleRevision          Int      @default(0)
  retentionPurgedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  dealer   DealerProfile? @relation(fields: [dealerId], references: [id])
  category Category       @relation(fields: [categoryId], references: [id])
  region   Region         @relation(fields: [regionId], references: [id])

  images             ListingImage[]
  imageUploadIntents ListingImageUploadIntent[]
  attributeValues    ListingAttributeValue[]
  payments        Payment[]
  reports         Report[]
  favouritedBy    Favourite[]
  views           ListingView[]
  statusEvents    ListingStatusEvent[]
  revisions       ListingRevision[]
  freeListingClaim FreeListingClaim?

  @@index([categoryId, regionId, status])
  @@index([status])
  @@index([price])
  @@index([slug])
  @@index([userId])
  @@index([dealerId])
  @@index([createdAt])
}

model ListingStatusEvent {
  id              String                   @id @default(cuid())
  listingId       String
  fromStatus      ListingStatus?
  toStatus        ListingStatus
  changedByUserId String?
  source          ListingStatusEventSource
  action          ListingLifecycleAction?
  reasonCode      ListingModerationReason?
  moderationSubReason       String?
  moderationTaxonomyVersion String?
  reportId        String?
  notes           String?
  createdAt       DateTime                 @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  report    Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([changedByUserId, createdAt])
  @@index([toStatus, createdAt])
  @@index([reportId])
}

model FreeListingClaim {
  id        String   @id @default(cuid())
  userId    String   @unique
  listingId String   @unique
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

enum ListingImageProvider {
  CLOUDINARY
  EXTERNAL
}

enum ListingImageUploadIntentStatus {
  ISSUED
  VERIFIED
  CONSUMED
  REJECTED
  EXPIRED
}

enum ListingImageCleanupJobStatus {
  PENDING
  COMPLETED
  FAILED
}

model ListingImage {
  id             String                @id @default(cuid())
  listingId      String
  url            String
  publicId       String
  order          Int                   @default(0)
  provider       ListingImageProvider  @default(CLOUDINARY)
  assetId        String?
  version        String?
  width          Int?
  height         Int?
  format         String?
  bytes          Int?
  uploadIntentId String?               @unique
  focalX         Float?
  focalY         Float?

  listing      Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadIntent ListingImageUploadIntent? @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)

  @@unique([listingId, order])
  @@unique([provider, publicId])
  @@index([listingId])
}

model ListingImageUploadIntent {
  id           String                         @id @default(cuid())
  userId       String
  listingId    String?
  publicId     String                         @unique
  folder       String
  status       ListingImageUploadIntentStatus @default(ISSUED)
  expiresAt    DateTime
  assetId      String?
  version      String?
  width        Int?
  height       Int?
  format       String?
  bytes        Int?
  deliveryType String                         @default("private")
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  image   ListingImage?
  revisionImage ListingRevisionImage?

  @@index([userId, status])
  @@index([expiresAt, status])
}

model ListingImageCleanupJob {
  id           String                       @id @default(cuid())
  publicId     String
  deliveryType String                       @default("private")
  reason       String
  status       ListingImageCleanupJobStatus @default(PENDING)
  attempts     Int                          @default(0)
  lastError    String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  completedAt  DateTime?

  @@index([status, createdAt])
}

model ListingAttributeValue {
  id                    String @id @default(cuid())
  listingId             String
  attributeDefinitionId String
  value                 String

  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([listingId, attributeDefinitionId])
  @@index([attributeDefinitionId, value])
}

enum ListingRevisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISCARDED
}

model ListingRevision {
  id                         String                 @id @default(cuid())
  listingId                  String
  title                      String
  description                String
  price                      Int
  categoryId                 String
  regionId                   String
  trustDeclarationAccepted   Boolean                @default(false)
  trustDeclarationAcceptedAt DateTime?
  status                     ListingRevisionStatus  @default(DRAFT)
  version                    Int                    @default(0)
  reasonCode                 ListingModerationReason?
  moderationSubReason        String?
  moderationTaxonomyVersion  String?
  notes                      String?
  submittedAt                DateTime?
  decidedAt                  DateTime?
  decidedByUserId            String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id])
  region    Region   @relation(fields: [regionId], references: [id])
  decidedBy User?    @relation("ListingRevisionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  images    ListingRevisionImage[]
  attributeValues ListingRevisionAttributeValue[]

  @@index([listingId, status])
  @@index([status, submittedAt])
  @@index([decidedByUserId])
}

model ListingRevisionImage {
  id             String               @id @default(cuid())
  revisionId     String
  url            String
  publicId       String
  order          Int                  @default(0)
  provider       ListingImageProvider @default(CLOUDINARY)
  assetId        String?
  version        String?
  width          Int?
  height         Int?
  format         String?
  bytes          Int?
  uploadIntentId String?              @unique
  focalX         Float?
  focalY         Float?

  revision     ListingRevision            @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  uploadIntent ListingImageUploadIntent?  @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)

  @@unique([revisionId, order])
  @@unique([revisionId, provider, publicId])
  @@index([revisionId])
  @@index([provider, publicId])
}

model ListingRevisionAttributeValue {
  id                    String @id @default(cuid())
  revisionId            String
  attributeDefinitionId String
  value                 String

  revision            ListingRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, attributeDefinitionId])
  @@index([attributeDefinitionId, value])
}

// ---------------------------------------------------------------------------
// Payments & Subscriptions
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentType {
  LISTING
  FEATURED
  SUPPORT
}

enum PaymentProvider {
  STRIPE
  RIPPLE
  DEV
  ADMIN
}

enum SubscriptionSource {
  PAYMENT
  ADMIN_GRANT
}

model Payment {
  id                             String          @id @default(cuid())
  listingId                      String
  paymentProvider                PaymentProvider @default(STRIPE)
  providerPaymentId              String?         @unique
  providerReference              String?         @unique
  stripePaymentId                String?         @unique
  amount                         Int             // in pence
  currency                       String          @default("gbp")
  type                           PaymentType     @default(LISTING)
  status                         PaymentStatus   @default(PENDING)
  idempotencyKey                 String?         @unique
  refundReason                   RefundReason?
  refundedAt                     DateTime?
  lastProviderEventAt            DateTime?
  lastProviderEventType          String?
  lastProviderEventFingerprint   String?
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([paymentProvider])
  @@index([providerPaymentId])
  @@index([providerReference])
  @@index([stripePaymentId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum SubscriptionProviderLifecycle {
  NONE
  CREATED
  ACTIVE
  PAUSED
  CANCELLED
}

enum WebhookInboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  QUARANTINED
}

model Subscription {
  id                             String                         @id @default(cuid())
  dealerId                       String
  paymentProvider                PaymentProvider                @default(STRIPE)
  source                         SubscriptionSource             @default(PAYMENT)
  providerSubscriptionId         String?                        @unique
  providerPlanId                 String?
  stripeSubscriptionId           String?                        @unique
  stripePriceId                  String?
  status                         SubscriptionStatus             @default(INCOMPLETE)
  currentPeriodEnd               DateTime?
  grantStartsAt                  DateTime?
  grantEndsAt                    DateTime?
  grantedByAdminId               String?
  revokedAt                      DateTime?
  cancelAtPeriodEnd              Boolean                        @default(false)
  providerLifecycle              SubscriptionProviderLifecycle  @default(NONE)
  customerEmailNorm              String?
  lastProviderEventAt            DateTime?
  lastProviderEventType          String?
  lastProviderEventFingerprint   String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  dealer  DealerProfile         @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  charges SubscriptionCharge[]
  cancellationRequests DealerCancellationRequest[]

  @@index([dealerId])
  @@index([dealerId, source, status, grantEndsAt])
  @@index([paymentProvider])
  @@index([providerSubscriptionId])
  @@index([stripeSubscriptionId])
  @@index([customerEmailNorm, providerPlanId])
}

model SubscriptionCharge {
  id               String   @id @default(cuid())
  subscriptionId   String
  paymentReference String   @unique
  amount           Int
  currency         String   @default("gbp")
  eventTimestamp   DateTime
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model PaymentWebhookInbox {
  id                String             @id @default(cuid())
  bodyHash          String             @unique
  eventType         String
  eventTimestamp    DateTime
  clientId          String
  paymentReference  String?
  merchantReference String?
  linkCode          String?
  packageName       String?
  customerEmailNorm String?
  amountPence       Int?
  currency          String?
  recurring         Boolean?
  linkType          String?
  minimizedPayload  Json
  status            WebhookInboxStatus @default(PENDING)
  attemptCount      Int                @default(0)
  lastErrorCode     String?
  processedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([eventType, eventTimestamp])
  @@index([paymentReference])
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

model Report {
  id            String           @id @default(cuid())
  listingId     String
  reporterId    String?
  reporterEmail String
  reason        String
  reasonCode    ReportReasonCode?
  status        ReportStatus     @default(OPEN)
  adminNotes    String?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  listing      Listing              @relation(fields: [listingId], references: [id])
  reporter     User?                @relation(fields: [reporterId], references: [id])
  statusEvents ListingStatusEvent[]

  @@index([listingId])
  @@index([status])
}

model DealerReview {
  id                String             @id @default(cuid())
  dealerId          String
  reviewerUserId    String?
  reviewerDeviceId  String?
  reviewerType      DealerReviewerType
  reviewerName      String?
  rating            Int
  comment           String?
  status            DealerReviewStatus @default(PENDING)
  adminNotes        String?
  moderationVersion Int                @default(0)
  moderatedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  dealer   DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  reviewer User?         @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)
  moderationEvents DealerReviewModerationEvent[]
  response         DealerReviewResponse?
  disputes         DealerReviewDispute[]

  @@unique([dealerId, reviewerUserId])
  @@unique([dealerId, reviewerDeviceId])
  @@index([dealerId, status, createdAt])
  @@index([status, createdAt])
}

model DealerReviewModerationEvent {
  id              String                         @id @default(cuid())
  reviewId        String
  fromStatus      DealerReviewStatus?
  toStatus        DealerReviewStatus
  reasonCode      DealerReviewModerationReason?
  adminNotes      String?
  changedByUserId String?
  reviewVersion   Int                           @default(0)
  createdAt       DateTime                       @default(now())

  review    DealerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  changedBy User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
}

model DealerReviewResponse {
  id                 String    @id @default(cuid())
  reviewId           String    @unique
  approvedBody       String?
  approvedRevisionId String?   @unique
  version            Int       @default(0)
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  review           DealerReview                   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  revisions        DealerReviewResponseRevision[] @relation("DealerReviewResponseRevisions")
  approvedRevision DealerReviewResponseRevision?  @relation("DealerReviewApprovedRevision", fields: [approvedRevisionId, id], references: [id, responseId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([approvedRevisionId, id])
  @@index([reviewId, approvedAt])
}

model DealerReviewResponseRevision {
  id              String                             @id @default(cuid())
  responseId      String
  body            String
  status          DealerReviewResponseRevisionStatus @default(DRAFT)
  version         Int                                @default(0)
  reasonCode      DealerReviewModerationReason?
  adminNotes      String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt

  response         DealerReviewResponse                  @relation("DealerReviewResponseRevisions", fields: [responseId], references: [id], onDelete: Cascade)
  approvedFor      DealerReviewResponse?                 @relation("DealerReviewApprovedRevision")
  decidedBy        User?                                 @relation("DealerResponseRevisionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  moderationEvents DealerReviewResponseModerationEvent[]

  @@unique([id, responseId])
  @@index([responseId, status])
  @@index([status, submittedAt])
  @@index([decidedByUserId])
}

model DealerReviewResponseModerationEvent {
  id              String                             @id @default(cuid())
  revisionId      String
  fromStatus      DealerReviewResponseRevisionStatus
  toStatus        DealerReviewResponseRevisionStatus
  reasonCode      DealerReviewModerationReason?
  adminNotes      String?
  revisionVersion Int
  responseVersion Int
  reviewVersion   Int                                @default(0)
  changedByUserId String?
  createdAt       DateTime                           @default(now())

  revision  DealerReviewResponseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  changedBy User?                        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([revisionId, createdAt])
  @@index([changedByUserId])
}

model DealerReviewDispute {
  id                 String                        @id @default(cuid())
  reviewId           String
  openedByUserId     String?
  reasonCode         DealerReviewModerationReason
  body               String
  evidenceMetadata   Json?
  status             DealerReviewDisputeStatus     @default(OPEN)
  version            Int                           @default(0)
  decisionReasonCode DealerReviewModerationReason?
  adminNotes         String?
  decidedAt          DateTime?
  decidedByUserId    String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  review    DealerReview               @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  openedBy  User?                      @relation("DealerReviewDisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: SetNull)
  decidedBy User?                      @relation("DealerReviewDisputeDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  events    DealerReviewDisputeEvent[]

  @@index([reviewId, status, createdAt])
  @@index([status, createdAt])
  @@index([openedByUserId])
  @@index([decidedByUserId])
}

model DealerReviewDisputeEvent {
  id              String                       @id @default(cuid())
  disputeId       String
  fromStatus      DealerReviewDisputeStatus
  toStatus        DealerReviewDisputeStatus
  reasonCode      DealerReviewModerationReason
  adminNotes      String?
  disputeVersion  Int
  reviewVersion   Int                          @default(0)
  changedByUserId String?
  createdAt       DateTime                     @default(now())

  dispute   DealerReviewDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  changedBy User?               @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([disputeId, createdAt])
  @@index([changedByUserId])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model SavedSearch {
  id              String   @id @default(cuid())
  userId          String
  name            String
  queryParamsJson Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ListingView {
  id         String   @id @default(cuid())
  listingId  String
  viewerId   String?
  viewerHash String
  viewerHashVersion Int @default(1)
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([viewerHash, createdAt])
}

model WaitlistUser {
  id               String    @id @default(cuid())
  email            String    @unique
  interests        Json
  source           String    @default("coming_soon_page")
  deletedAt        DateTime?
  deletedByAdminId String?
  deletionReason   String?
  marketingConsentAt DateTime?
  marketingPolicyVersion String?
  marketingWithdrawnAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Monitoring
// ---------------------------------------------------------------------------

enum MonitoringIssueStatus {
  OPEN
  ACKNOWLEDGED
  MUTED
  RESOLVED
}

enum MonitoringSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MonitoringSource {
  SERVER
  CLIENT
  WEBHOOK
  BUSINESS
}

enum MonitoringAlertChannel {
  EMAIL
  WEBHOOK
}

enum MonitoringAlertStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model MonitoringIssue {
  id               String                @id @default(cuid())
  fingerprint      String                @unique
  title            String
  status           MonitoringIssueStatus @default(OPEN)
  severity         MonitoringSeverity    @default(MEDIUM)
  source           MonitoringSource
  firstSeenAt      DateTime              @default(now())
  lastSeenAt       DateTime              @default(now())
  occurrences      Int                   @default(1)
  sampleMessage    String
  sampleRoute      String?
  sampleAction     String?
  sampleComponent  String?
  mutedUntil       DateTime?
  resolvedAt       DateTime?
  assigneeAdminId  String?
  lastAlertedAt    DateTime?
  lastGeneratedPrompt String?
  lastPromptGeneratedAt DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  events           MonitoringEvent[]
  alertDeliveries  MonitoringAlertDelivery[]
  statusEvents     MonitoringIssueStatusEvent[]

  @@index([status, severity, lastSeenAt])
  @@index([source, lastSeenAt])
  @@index([createdAt])
}

model MonitoringIssueStatusEvent {
  id              String                @id @default(cuid())
  issueId         String
  fromStatus      MonitoringIssueStatus?
  toStatus        MonitoringIssueStatus
  changedByUserId String?
  notes           String?
  createdAt       DateTime              @default(now())

  issue     MonitoringIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  changedBy User?           @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

model MonitoringEvent {
  id             String             @id @default(cuid())
  issueId        String
  source         MonitoringSource
  severity       MonitoringSeverity
  environment    String
  message        String
  stack          String?
  route          String?
  action         String?
  component      String?
  requestMethod  String?
  requestPath    String?
  requestId      String?
  userId         String?
  userEmail      String?
  ipHash         String?
  tags           Json?
  extra          Json?
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())

  issue          MonitoringIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  alertDeliveries MonitoringAlertDelivery[]

  @@index([issueId, occurredAt])
  @@index([source, severity, occurredAt])
  @@index([requestPath, occurredAt])
}

model MonitoringAlertDelivery {
  id          String                @id @default(cuid())
  issueId      String?
  eventId      String?
  channel      MonitoringAlertChannel
  target       String
  status       MonitoringAlertStatus @default(PENDING)
  attempts     Int                   @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  issue        MonitoringIssue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)
  event        MonitoringEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([channel, status, createdAt])
  @@index([issueId, createdAt])
  @@index([eventId, createdAt])
}

// ---------------------------------------------------------------------------
// Admin Audit Log
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CMS Content Pages
// ---------------------------------------------------------------------------

enum ContentPageStatus {
  DRAFT
  PUBLISHED
}

model ContentPage {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  markdown        String
  metaTitle       String?
  metaDescription String?
  status          ContentPageStatus @default(DRAFT)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slug])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Site Settings (DB-backed overrides)
// ---------------------------------------------------------------------------

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ---------------------------------------------------------------------------
// Policy acceptance, cancellation, deletion, and retention
// ---------------------------------------------------------------------------

enum PolicyAcceptanceType {
  AGE_18
  ACCOUNT_BUNDLE
  LISTING_BUNDLE
  DEALER_BUNDLE
  PRIVACY_NOTICE
}

enum PolicyAcceptanceSource {
  SIGNUP
  GATE
  LISTING
  SUBSCRIBE
}

model PolicyAcceptance {
  id             String                 @id @default(cuid())
  userId         String
  acceptanceType PolicyAcceptanceType
  bundleVersion  String
  policyVersions Json
  source         PolicyAcceptanceSource
  createdAt      DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, acceptanceType, bundleVersion])
  @@index([userId, acceptanceType])
}

enum CancellationRequestStatus {
  REQUESTED
  ACKNOWLEDGED
  RECONCILED
  COMPLETED
  REJECTED
}

model DealerCancellationRequest {
  id                 String                    @id @default(cuid())
  dealerId           String
  subscriptionId     String
  requestedByUserId  String
  status             CancellationRequestStatus @default(REQUESTED)
  idempotencyKey     String                    @unique
  requestedAt        DateTime                  @default(now())
  periodEndAt        DateTime
  processedAt        DateTime?
  processedByAdminId String?
  notes              String?
  lastError          String?

  dealer        DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  subscription  Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  requestedBy   User          @relation("CancellationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  processedBy   User?         @relation("CancellationProcessedBy", fields: [processedByAdminId], references: [id], onDelete: Restrict)
  events        DealerCancellationRequestEvent[]

  @@index([dealerId, status])
  @@index([subscriptionId, status])
}

model DealerCancellationRequestEvent {
  id          String                    @id @default(cuid())
  requestId   String
  fromStatus  CancellationRequestStatus?
  toStatus    CancellationRequestStatus
  actorUserId String?
  source      String
  metadata    Json?
  createdAt   DateTime                  @default(now())

  request DealerCancellationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

enum AccountDeletionJobStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AccountDeletionPhase {
  REQUESTED
  AUTH
  MEDIA
  ANONYMISE
  COMPLETED
}

model AccountDeletionJob {
  id             String                   @id @default(cuid())
  userId         String                   @unique
  status         AccountDeletionJobStatus @default(REQUESTED)
  phase          AccountDeletionPhase     @default(REQUESTED)
  attempts       Int                      @default(0)
  lastError      String?
  lockedAt       DateTime?
  leaseToken     String?
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime?
  requestedAt    DateTime                 @default(now())
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}

model RetentionLegalHold {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  reason     String
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  @@index([entityType, entityId])
}

model RetentionRun {
  id          String    @id @default(cuid())
  mode        String
  entityTypes Json
  status      String
  counts      Json?
  sampleIds   Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// ---------------------------------------------------------------------------
// Project cost ledger
// ---------------------------------------------------------------------------

enum CostCategory {
  CURSOR
  VERCEL_HOSTING
  DATABASE
  SHARED_VERCEL
  OTHER
}

enum CostEntryKind {
  CHARGE
  REVERSAL
}

enum CostInvoiceability {
  INVOICEABLE
  PROVISIONAL
}

enum CostSourceKind {
  VERCEL_FOCUS
  MANUAL
}

enum InvoiceRequestStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CostEmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum CostSyncTrigger {
  DEPLOYMENT
  CRON
  MANUAL
}

enum CostSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model CostLedgerConfig {
  id            String   @id
  startedAt     DateTime @db.Timestamptz(3)
  policyVersion String
  createdAt     DateTime @default(now())
}

model FxRateSnapshot {
  id            String   @id @default(cuid())
  pair          String
  rate          Decimal  @db.Decimal(20, 8)
  provider      String
  captureDate   DateTime @db.Date
  effectiveDate DateTime @db.Date
  fetchedAt     DateTime
  createdAt     DateTime @default(now())

  entries CostEntry[]

  @@unique([pair, effectiveDate, provider])
  @@index([pair, effectiveDate])
}

model CostSourceSnapshot {
  id               String         @id @default(cuid())
  sourceKind       CostSourceKind
  bucketKey        String
  revision         Int
  checksum         String
  periodStart      DateTime
  periodEnd        DateTime
  classified       Boolean
  quarantined      Boolean        @default(false)
  quarantineReason String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  entries CostEntry[]

  @@unique([sourceKind, bucketKey, revision])
  @@index([bucketKey, revision])
  @@index([quarantined, createdAt])
}

model CostEntry {
  id                 String             @id @default(cuid())
  category           CostCategory
  kind               CostEntryKind
  invoiceability     CostInvoiceability
  sourceKind         CostSourceKind
  sourceSnapshotId   String
  reversesEntryId    String?
  fxRateSnapshotId   String?
  nativeAmount       Decimal            @db.Decimal(20, 8)
  nativeCurrency     String
  markedGbpMinor     BigInt
  servicePeriodStart DateTime
  servicePeriodEnd   DateTime
  displayLabel       String
  createdAt          DateTime           @default(now())

  sourceSnapshot CostSourceSnapshot   @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  reversesEntry  CostEntry?           @relation("CostEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy     CostEntry[]          @relation("CostEntryReversal")
  fxRateSnapshot FxRateSnapshot?      @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)
  invoiceLines   InvoiceRequestLine[]
  settlement     CostSettlement?

  @@unique([sourceSnapshotId, kind])
  @@unique([reversesEntryId])
  @@index([category, createdAt])
  @@index([invoiceability, createdAt])
  @@index([createdAt])
}

model CostSyncLock {
  id        String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model CostSyncRun {
  id               String          @id @default(cuid())
  trigger          CostSyncTrigger
  status           CostSyncStatus
  eventId          String?         @unique
  queryFrom        DateTime
  queryTo          DateTime
  checksum         String?
  classifiedCount  Int             @default(0)
  quarantinedCount Int             @default(0)
  errorCode        String?
  startedAt        DateTime        @default(now())
  completedAt      DateTime?

  @@index([status, startedAt])
}

model InvoiceRequest {
  id               String               @id @default(cuid())
  status           InvoiceRequestStatus
  openSlot         String?
  requesterUserId  String
  confirmerUserId  String?
  frozenGbpMinor   BigInt
  frozenEntryCount Int
  createdAt        DateTime             @default(now())
  confirmedAt      DateTime?

  lines       InvoiceRequestLine[]
  settlements CostSettlement[]
  events      CostWorkflowEvent[]
  emails      CostEmailOutbox[]

  @@unique([openSlot])
  @@index([status, createdAt])
}

model InvoiceRequestLine {
  id               String @id @default(cuid())
  invoiceRequestId String
  costEntryId      String
  markedGbpMinor   BigInt

  request InvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict)
  entry   CostEntry      @relation(fields: [costEntryId], references: [id], onDelete: Restrict)

  @@unique([invoiceRequestId, costEntryId])
  @@index([costEntryId])
}

model CostSettlement {
  id               String   @id @default(cuid())
  costEntryId      String   @unique
  invoiceRequestId String
  markedGbpMinor   BigInt
  createdAt        DateTime @default(now())

  entry   CostEntry      @relation(fields: [costEntryId], references: [id], onDelete: Restrict)
  request InvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict)

  @@index([invoiceRequestId])
}

model CostWorkflowEvent {
  id               String   @id @default(cuid())
  invoiceRequestId String?
  type             String
  actorUserId      String?
  payload          Json?
  createdAt        DateTime @default(now())

  request InvoiceRequest? @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict)

  @@index([invoiceRequestId, createdAt])
  @@index([type, createdAt])
}

model CostEmailOutbox {
  id                String                @id @default(cuid())
  invoiceRequestId  String
  kind              String
  status            CostEmailOutboxStatus @default(PENDING)
  attemptCount      Int                   @default(0)
  lastError         String?
  providerMessageId String?
  nextAttemptAt     DateTime?
  claimedAt         DateTime?
  createdAt         DateTime              @default(now())
  sentAt            DateTime?

  request InvoiceRequest @relation(fields: [invoiceRequestId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
}
