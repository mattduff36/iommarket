# =============================================================================
# iTrader — Environment Variables Reference
# Copy this file to .env.local for local development.
# For production (Vercel), set these via the Vercel dashboard or CLI.
# NEVER commit .env.local or .env.production to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Direct connection (used for migrations/seeds). No pooling.
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# Prisma uses this pooled URL for runtime queries
POSTGRES_URL="postgres://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x"
POSTGRES_URL_NON_POOLING="postgres://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://postgres.[ref]:[password]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Individual Postgres credentials (used by Vercel Postgres integration)
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="db.[ref].supabase.co"
POSTGRES_PASSWORD="your-db-password"
POSTGRES_USER="postgres"

# -----------------------------------------------------------------------------
# Supabase Authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only — never expose to client
SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Secret for the Supabase "Send Email" auth hook (set in Supabase Auth → Hooks)
SUPABASE_AUTH_HOOK_SECRET="v1,whsec_..."

# -----------------------------------------------------------------------------
# Ripple Payments
# Keep RIPPLE_LIVE_CHECKOUT_ENABLED unset or 0 until underwriting and
# merchant_reference support are confirmed. Webhook ingestion stays active.
# -----------------------------------------------------------------------------
RIPPLE_CLIENT_ID="codelabplatfdcf3a8"
RIPPLE_WEBHOOK_SECRET="your-64-char-hmac-secret"
RIPPLE_REFERENCE_SECRET="replace-with-256-bit-random-secret"
# Optional previous secret used only while rotating RIPPLE_REFERENCE_SECRET
# RIPPLE_REFERENCE_SECRET_PREVIOUS=""
RIPPLE_LIVE_CHECKOUT_ENABLED="0"
RIPPLE_LISTING_PAYMENT_URL="https://portal.startyourripple.co.uk/card/codelabplatfdcf3a8/pay/74A7510E33E94821"
RIPPLE_FEATURED_PAYMENT_URL="https://portal.startyourripple.co.uk/card/codelabplatfdcf3a8/pay/1BB714D5DBC446B6"
RIPPLE_DEALER_STARTER_URL="https://portal.startyourripple.co.uk/card/codelabplatfdcf3a8/pay/8181FAC1359E413E"
RIPPLE_DEALER_PRO_URL="https://portal.startyourripple.co.uk/card/codelabplatfdcf3a8/pay/C5D44F6F18094B94"
RIPPLE_DASHBOARD_URL="https://portal.startyourripple.co.uk/portal/codelabplatfdcf3a8/card-portal"

# Free launch window: all private listings are free until this ISO timestamp.
# Set to a past date (or remove) to disable time-based free window.
LAUNCH_FREE_UNTIL="2026-03-31T23:59:59.000Z"

# How many days a free private listing remains active before expiring.
FREE_LISTING_WINDOW_DAYS="30"

# -----------------------------------------------------------------------------
# Cloudinary — Image Uploads
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="iommarket_unsigned"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# Email — Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="iTrader <no-reply@yourdomain.com>"
RESEND_REPLY_TO_EMAIL="support@yourdomain.com"
RESEND_REPORTS_TO_EMAIL="moderation@yourdomain.com"
# Comma-separated list of addresses that receive waitlist notifications
RESEND_WAITLIST_TO_EMAIL="admin1@yourdomain.com, admin2@yourdomain.com"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Local dev: http://localhost:4000 | Production: https://itrader.im
# Set the production origin explicitly. Vercel can fall back to its system
# VERCEL_PROJECT_PRODUCTION_URL host, but canonical env changes require a rebuild.
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Isle of Man ICO data controller registration reference (shown in footer)
NEXT_PUBLIC_IOM_DATA_CONTROLLER_REF="Pending registration"

# -----------------------------------------------------------------------------
# Dev access
# -----------------------------------------------------------------------------
# Password to unlock the full site at /dev/auth (bypasses holding page)
DEV_PASS="your-dev-password"

# Authorizes Vercel cron routes, including /api/cron/ripple-webhook-retry
CRON_SECRET="replace-with-cron-secret"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Featured listing fee in pence. Defaults to 1000 if not set.
# FEATURED_FEE_PENCE="1000"

# Monitoring alert recipients (comma-separated). Falls back to RESEND_REPORTS_TO_EMAIL.
# MONITORING_ALERT_EMAILS="ops@example.com,alerts@example.com"

# Optional webhook destination for monitoring alerts (Slack/Discord/custom endpoint).
# MONITORING_ALERT_WEBHOOK_URL="https://hooks.example.com/services/..."

# Minimum severity that triggers alerts: LOW | MEDIUM | HIGH | CRITICAL
# MONITORING_ALERT_MIN_SEVERITY="HIGH"

# Cooldown between alerts for the same issue (minutes)
# MONITORING_ALERT_COOLDOWN_MINUTES="30"

# -----------------------------------------------------------------------------
# Policy rollout flags
# Each boolean must be exactly true, false, or absent (absent = off).
# Rollback: set false or unset, then redeploy. Do not reverse migrations.
# -----------------------------------------------------------------------------
POLICY_ENFORCE_ACCEPTANCE="false"
POLICY_ENFORCE_LISTING_NS="false"
POLICY_ENABLE_CANCELLATION_REQUESTS="false"
POLICY_ENABLE_DELETION_WORKER="false"
POLICY_RETENTION_MUTATE="false"
# Comma-separated: LISTING,LISTING_VIEW,REPORT,DEALER_REVIEW,WAITLIST_USER
# MONITORING has no mutate path. Mutate requires this allowlist AND POLICY_RETENTION_MUTATE=true.
POLICY_RETENTION_ENTITY_ALLOWLIST=""
# Required for listing view writes. Generate a long random value; never commit the real secret.
VIEWER_HASH_SECRET=""

# -----------------------------------------------------------------------------
# Project cost ledger
# Keep disabled until schema, owner identity, and the next Vercel billing
# period start are verified. Rollback: set COSTS_ENABLED=false and redeploy.
# -----------------------------------------------------------------------------
COSTS_ENABLED="false"
COST_LEDGER_STARTED_AT="2026-09-01T07:00:00.000Z"
COST_OWNER_AUTH_USER_ID="supabase-auth-user-id"
COST_OWNER_NOTIFICATION_EMAIL="owner@example.com"
VERCEL_BILLING_TOKEN=""
COST_VERCEL_TEAM_ID="team_..."
COST_VERCEL_PROJECT_ID="prj_..."
COST_VERCEL_DATABASE_RESOURCE_ID="store_or_resource_id"
COST_SYNC_SECRET="replace-with-cost-sync-secret"
# Optional. Required for local/preview testing of the GitHub sync endpoint.
# COST_SYNC_ALLOW_NON_PROD="1"
