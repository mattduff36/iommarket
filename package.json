{
  "name": "iommarket",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@prisma/config@7.9.1": {
      "deepmerge-ts": "8.0.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack -p 4000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:vehicles": "npx tsx scripts/seed-vehicle-catalogue.ts",
    "seed:admin": "npx tsx scripts/seed-admin-users.ts",
    "tokens:generate": "npx tsx scripts/generate-ui-from-json.ts",
    "tokens:check": "npx tsx scripts/generate-ui-from-json.ts && echo 'Tokens up to date'",
    "dm-pack": "tsx scripts/generate-dm-policy-pack.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:env": "playwright test --config=playwright.env-check.config.ts",
    "test:e2e:env:list": "playwright test --config=playwright.env-check.config.ts --list",
    "test:e2e:ui": "playwright test --ui",
    "fixerrors": "npx tsx scripts/fixerrors.ts",
    "env:production:pull": "tsx scripts/production-env.ts pull",
    "env:production:check": "tsx scripts/production-env.ts check",
    "cursor:usage": "node --no-warnings --experimental-sqlite scripts/cursor-usage-export.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@once-ui-system/core": "^1.8.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.1",
    "pg": "^8.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.20.0",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@meterapp/vehicle-db": "^2.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^8.0.0",
    "docx": "^9.7.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vercel": "50.17.1",
    "vitest": "^4.1.10"
  }
}
